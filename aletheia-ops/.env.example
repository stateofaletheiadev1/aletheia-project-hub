# Aletheia Government Operations: server environment. Names, purpose and format only; never
# put real values in this file. Real values live in git-ignored .env*.local files and in the
# Vercel project settings (separate values for Preview, Staging and Production).

# development | staging | production. Production refuses to start unless every secret below is set.
APP_ENV=development
# Public address of this application.
APP_BASE_URL=http://localhost:3300
# Shown in the footer. Set by the build (e.g. the git commit).
BUILD_ID=local

# AletheiaDB, database "workbench", readWrite key (ADR 0002). Required in production.
# Format: aletheiadb://<keyId>:<secret>@db.stateofaletheia.org/workbench
ALETHEIADB_URL=

# 32 random bytes, base64 (openssl rand -base64 32). Seals authenticator secrets at rest.
# Back it up separately: without it no authenticator can be verified. Required in production.
DATA_ENCRYPTION_KEY=
# 32 random bytes, base64. Keys the hash used to find accounts by email. Required in production.
EMAIL_INDEX_KEY=

# portal: publish to aletheiagov.org through the signed endpoint (ADR 0003).
# development: simulate publication; a banner says so; refused in production.
PUBLICATION_MODE=development
PORTAL_BASE_URL=https://www.aletheiagov.org
# Shared with the portal's publication endpoint. Required when PUBLICATION_MODE=portal.
PORTAL_HMAC_KEY_ID=
# At least 32 random characters.
PORTAL_HMAC_SECRET=

# At least 32 random characters. Vercel Cron sends it as a Bearer token to the retry job.
CRON_SECRET=
