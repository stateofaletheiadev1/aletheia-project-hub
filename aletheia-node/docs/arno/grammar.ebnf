(* Arno 0.1 grammar (spec Section 25.6, APS-0013). The parser in crates/arno/src/parser.rs
   implements exactly this. Keywords are case-insensitive. Words in single quotes marked
   (contextual) are ordinary identifiers everywhere except in the position shown.

   Comments: { ... } and (* ... *). There is no line comment.
   Literals: decimal integers with optional '_' separators (0 .. 2^128 - 1); text in single
   quotes, '' for a quote inside text. There is no '/' operator. *)

Unit          = "contract" Ident ";" "version" Version ";" [ UsesClause ]
                { ConstSection | TypeSection | ErrorsSection | EventsSection | StorageSection }
                { Routine } "end" "." ;
Version       = Integer "." Integer ;                       (* each part 0 .. 65535 *)
UsesClause    = "uses" QualIdent { "," QualIdent } ";" ;
QualIdent     = Ident { "." Ident } ;

ConstSection  = "const" { Ident "=" Expr ";" } ;
TypeSection   = "type" { Ident "=" TypeDef ";" } ;
TypeDef       = "(" Ident { "," Ident } ")"                  (* enumeration *)
              | "record" { FieldGroup ";" } "end"
              | Type ;
ErrorsSection = "errors" { Ident "=" Text ";" } ;
EventsSection = "events" { Ident [ Params ] ";" } ;
StorageSection= "storage" { FieldGroup ";" } ;
FieldGroup    = Ident { "," Ident } ":" Type ;
Params        = "(" [ FieldGroup { ";" FieldGroup } ] ")" ;

Type          = "array" "[" Expr ".." Expr "]" "of" Type
              | 'List' "of" Type 'max' Expr                  (* contextual: List, max *)
              | 'Map' "of" Type "to" Type
              | 'Optional' "of" Type
              | 'Coins' "of" QualIdent
              | 'Vault' "of" QualIdent
              | 'Text' 'max' Expr
              | 'Bytes' "[" Expr "]"
              | 'Bytes' 'max' Expr
              | QualIdent ;

Routine       = ( "constructor" | "procedure" | "function" ) Ident [ Params ] [ ":" Type ] ";"
                { Directive ";" } [ Effects ";" ] [ VarSection ] Block ";" ;
Directive     = "entry" | "view" | "reentrant" ;
Effects       = Effect { "," Effect } ;
Effect        = 'changes' "storage" | 'receives' 'coins' | 'sends' 'coins'
              | 'emits' "events" | 'calls' 'contracts' ;
VarSection    = "var" { FieldGroup ";" } ;

Block         = "begin" [ Statement { ";" Statement } ] "end" ;
Statement     = [ Assign | Call | IfStmt | CaseStmt | ForStmt | ForEachStmt | WhileStmt
              | RequireStmt | FailStmt | EmitStmt | "exit" | Block ] ;   (* may be empty *)
Assign        = Designator ":=" Expr ;
Call          = Designator ;                                (* a routine, with or without ( ) *)
IfStmt        = "if" Expr "then" Statement [ "else" Statement ] ;
CaseStmt      = "case" Expr "of" { CaseArm ";" } [ "else" Statement [ ";" ] ] "end" ;
CaseArm       = Expr { "," Expr } ":" Statement ;
ForStmt       = "for" Ident ":=" Expr "to" Expr "do" Statement ;
ForEachStmt   = "for" 'each' Ident "in" Expr "do" Statement ;
WhileStmt     = "while" Expr 'at' 'most' Expr 'times' "do" Statement ;   (* bound required: A4002 *)
RequireStmt   = "require" Expr "otherwise" Ident ;
FailStmt      = "fail" Ident ;
EmitStmt      = "emit" Ident [ "(" [ Expr { "," Expr } ] ")" ] ;

(* Expressions, lowest precedence first. Comparisons bind tighter than and/or, so
   'X > 0 and Y > 0' reads as written (a deliberate difference from classic Pascal), and
   comparisons do not chain (A1108). *)
Expr          = AndExpr { ( "or" | "xor" ) AndExpr } ;
AndExpr       = Comparison { "and" Comparison } ;
Comparison    = Sum [ ( "=" | "<>" | "<" | "<=" | ">" | ">=" ) Sum ] ;
Sum           = Product { ( "+" | "-" ) Product } ;
Product       = Unary { ( "*" | "div" | "mod" ) Unary } ;
Unary         = ( "not" | "-" ) Unary | Postfix ;
Postfix       = Primary { "." Ident | "[" Expr "]" | "(" [ Expr { "," Expr } ] ")" } ;
Primary       = Integer | Text | "true" | "false" | "move" Ident | Ident | "(" Expr ")" ;
Designator    = Postfix ;
