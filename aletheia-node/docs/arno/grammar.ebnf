(* Arno 0.1 grammar (spec Section 25.6, APS-0013, syntax per ADR-049). The parser in
   crates/arno/src/parser.rs implements exactly this. Keywords are case-insensitive. Words in
   single quotes marked (contextual) are ordinary identifiers everywhere except in the
   position shown.

   Comments: // to the end of the line, and /* ... */.
   Literals: decimal integers with optional '_' separators (0 .. 2^128 - 1); text in double
   quotes, with \" for a quote and \\ for a backslash. There is no '/' operator. *)

Unit          = "contract" Ident "{" "version" Version ";" [ UsesClause ] { Member } "}" ;
Version       = Integer "." Integer ;                       (* each part 0 .. 65535 *)
UsesClause    = "uses" QualIdent { "," QualIdent } ";" ;    (* 'Coins' means 'Std.Coins' *)
QualIdent     = Ident { "." Ident } ;

Member        = Constant | TypeAlias | Enum | Record | ErrorDecl | EventDecl
              | Variable | Constructor | Function ;
Constant      = "constant" Ident "=" Expr ";" ;
TypeAlias     = "type" Ident "=" Type ";" ;
Enum          = "enum" Ident "{" Ident { "," Ident } [ "," ] "}" ;
Record        = "record" Ident "{" { Declared } "}" ;
ErrorDecl     = "error" Ident Text ";" ;
EventDecl     = "event" Ident [ Params ] ";" ;
Variable      = [ "private" ] Declared ;                    (* 'public' is refused: A1110 *)
Declared      = Type Ident { "," Ident } ";" ;
Params        = "(" [ Type Ident { "," Type Ident } ] ")" ;

Type          = "array" "[" Expr ".." Expr "]" "of" Type
              | 'List' "of" Type 'max' Expr                  (* contextual: List, max *)
              | 'Map' "of" Type "to" Type
              | 'Optional' "of" Type
              | 'Coins' "of" QualIdent
              | 'Vault' "of" QualIdent
              | 'Text' 'max' Expr
              | 'Bytes' "[" Expr "]"
              | 'Bytes' 'max' Expr
              | QualIdent ;

Constructor   = "constructor" Params [ Effects ] Block ;
Function      = { "public" | "private" | "view" | "reentrant" } "function" Ident Params
                [ "returns" Type ] [ Effects ] Block ;
Effects       = Effect { "," Effect } ;
Effect        = 'changes' 'storage' | 'receives' 'coins' | 'sends' 'coins'
              | 'emits' 'events' | 'calls' 'contracts' ;

Block         = "{" { Statement } "}" ;
Statement     = ";" | Block | IfStmt | SwitchStmt | ForStmt | ForEachStmt | WhileStmt
              | RequireStmt | FailStmt | EmitStmt | ReturnStmt | LocalDecl
              | Designator "=" Expr ";"                      (* assignment *)
              | Designator ";" ;                             (* a call, with or without ( ) *)
LocalDecl     = Type Ident [ "=" Expr ] { "," Ident [ "=" Expr ] } ";" ;
IfStmt        = "if" Expr Block [ "else" ( IfStmt | Block ) ] ;
SwitchStmt    = "switch" Expr "{" { "case" Expr { "," Expr } "->" Statement }
                [ "default" "->" Statement ] "}" ;
ForStmt       = "for" [ Type ] Ident 'from' Expr "to" Expr Block ;
ForEachStmt   = "for" 'each' [ Type ] Ident "in" Expr Block ;
WhileStmt     = "while" Expr 'at' 'most' Expr 'times' Block ;   (* bound required: A4002 *)
RequireStmt   = "require" Expr "otherwise" Ident ";" ;
FailStmt      = "fail" Ident ";" ;
EmitStmt      = "emit" Ident [ "(" [ Expr { "," Expr } ] ")" ] ";" ;
ReturnStmt    = "return" [ Expr ] ";" ;

(* Expressions, lowest precedence first. Comparisons bind tighter than and/or, so
   'x > 0 and y > 0' reads as written, and comparisons do not chain (A1108). 'is not' is
   one operator. *)
Expr          = AndExpr { ( "or" | "xor" ) AndExpr } ;
AndExpr       = Comparison { "and" Comparison } ;
Comparison    = Sum [ ( "is" | "is" "not" | "<" | "<=" | ">" | ">=" ) Sum ] ;
Sum           = Product { ( "+" | "-" ) Product } ;
Product       = Unary { ( "*" | "div" | "mod" ) Unary } ;
Unary         = ( "not" | "-" ) Unary | Postfix ;
Postfix       = Primary { "." Ident | "[" Expr "]" | "(" [ Expr { "," Expr } ] ")" } ;
Primary       = Integer | Text | "true" | "false" | "move" Ident | Ident | "(" Expr ")" ;
Designator    = Postfix ;
