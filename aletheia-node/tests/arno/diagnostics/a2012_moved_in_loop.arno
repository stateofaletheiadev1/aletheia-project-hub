{ A2012: coins moved inside a loop. }
contract Escrow;
version 0.1;
uses Std.Coins, Std.Auth;

storage
  Seller: Address;

procedure Spray(Caller: Signer; Deposit: Coins of AEY); entry;
  receives coins, sends coins;
var
  I: UInt64;
begin
  for I := 1 to 3 do
    Transfer(move Deposit, Seller);
end;

end.
