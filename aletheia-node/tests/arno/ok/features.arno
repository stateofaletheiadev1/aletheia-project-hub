// A contract that uses most of Arno 0.1. It must check with no messages.
contract Treasury {
    version 0.1;
    uses Coins, Auth, Chain, Math;

    constant MaxMembers = 50;
    constant FeeBps = 25;
    constant Ten = 2 * 5;

    enum Role { Viewer, Spender, Admin }

    record Member {
        Address wallet;
        Role level;
        UInt128 limit;
    }

    error NotAdmin "Only an admin can do this.";
    error TooMuch  "The amount is above the member's limit.";
    error Unknown  "This address is not a member.";
    error Empty    "The treasury holds nothing.";

    event Paid(Address wallet, UInt128 amount, UInt128 fee);
    event Joined(Address wallet);

    private Address owner;
    private List of Member max MaxMembers members;
    private Map of Address to UInt128 limits;
    private Vault of AEY funds, fees;
    private Optional of Slot lastPaid;
    private Height opened;

    constructor(Signer caller) changes storage {
        owner = caller.address;
        funds = Vault.Empty;
        fees = Vault.Empty;
        lastPaid = Nothing;
        opened = Chain.height;
    }

    public view function isAdmin(Address who) returns Boolean {
        if who is owner {
            return true;
        }
        for each person in members {
            if person.wallet is who and person.level is Admin {
                return true;
            }
        }
        return false;
    }

    public view function feeOn(UInt128 amount) returns UInt128 {
        return mulDiv(amount, FeeBps, 10000, RoundUp);
    }

    public function enrol(Signer caller, Address who, Role level, UInt128 limit)
        changes storage, emits events
    {
        require isAdmin(caller.address) otherwise NotAdmin;
        Member person;
        person.wallet = who;
        person.level = level;
        person.limit = limit;
        members.add(person);
        limits.put(who, limit);
        emit Joined(who);
    }

    public function fund(Signer caller, Coins of AEY deposit) changes storage, receives coins {
        funds.deposit(move deposit);
    }

    public function pay(Signer caller, UInt128 amount)
        changes storage, sends coins, emits events
    {
        Optional of UInt128 allowed = limits.get(caller.address);
        require allowed.isSome otherwise Unknown;
        require amount <= allowed.value otherwise TooMuch;
        require funds.balance > 0 otherwise Empty;
        UInt128 charged = feeOn(amount);
        Coins of AEY payment = funds.withdraw(amount + charged);
        Coins of AEY fee = split(payment, charged);
        fees.deposit(move fee);
        transfer(move payment, caller.address);
        lastPaid = some(Chain.slot);
        emit Paid(caller.address, amount, charged);
    }

    public function sweep(Signer caller) changes storage, sends coins {
        require caller.address is owner otherwise NotAdmin;
        Coins of AEY all = funds.withdrawAll;
        Coins of AEY more = fees.withdrawAll;
        join(all, move more);
        transfer(move all, owner);
    }

    public view function describe(Role level) returns UInt8 {
        switch level {
            case Viewer -> return 1;
            case Spender, Admin -> return 2;
            default -> return 0;
        }
    }

    public view function countdown(UInt64 start) returns UInt64 {
        UInt64 left = min(start, Ten);
        UInt64 steps = 0;
        while left > 0 at most 100 times {
            left = left - 1;
            steps = steps + 1;
        }
        for i from 1 to Ten {
            steps = steps + UInt64(describe(Admin));
        }
        return steps;
    }
}
