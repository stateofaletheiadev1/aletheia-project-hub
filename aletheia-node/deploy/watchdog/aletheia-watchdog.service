# One watchdog pass (aletheia-watchdog.sh). Started every minute by aletheia-watchdog.timer.
# Install to /etc/systemd/system/, then: systemctl daemon-reload && systemctl enable --now aletheia-watchdog.timer
[Unit]
Description=AletheiaChain liveness watchdog (node RPC, block progress, explorer)
After=aletheiad.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/aletheia-watchdog
# A restart waits for the node to stop (TimeoutStopSec=120) before starting it again.
TimeoutStartSec=300
Nice=5
