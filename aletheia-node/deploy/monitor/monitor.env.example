# /etc/aletheia/monitor.env (root:root 0600). A dedicated Zoho app password for the sending
# mailbox, never the mailbox's own password.
MONITOR_SMTP_HOST=smtp.zoho.com
MONITOR_SMTP_PORT=465
MONITOR_SMTP_USER=no-reply@stateofaletheia.org
MONITOR_SMTP_PASS=
MONITOR_MAIL_FROM=AletheiaChain monitor <no-reply@stateofaletheia.org>
MONITOR_MAIL_TO=info@stateofaletheia.org,emeka@stateofaletheia.org
