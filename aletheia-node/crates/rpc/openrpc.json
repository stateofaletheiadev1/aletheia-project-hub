{
  "openrpc": "1.2.6",
  "info": {
    "title": "AletheiaChain node RPC",
    "version": "1.0.0",
    "description": "JSON-RPC 2.0 at /rpc/v1 (POST), the same methods as REST under /api/v1, and WebSocket subscriptions at /ws/v1 (subscribe/unsubscribe with topics finalizedBlocks, transactionStatus {txId}, account {address}). Every read is of finalized state."
  },
  "servers": [
    {
      "name": "Mainnet Beta",
      "url": "https://rpc.stateofaletheia.org/rpc/v1"
    }
  ],
  "methods": [
    {
      "name": "getNetworkStatus",
      "summary": "Chain id, network kind, protocol version, connected peers, sync state and the finalized head.",
      "params": [],
      "result": {
        "name": "status",
        "schema": {
          "type": "object",
          "properties": {
            "chainId": {
              "type": "integer"
            },
            "network": {
              "type": "string",
              "enum": [
                "mainnet",
                "testnet",
                "devnet",
                "regtest"
              ]
            },
            "protocolVersion": {
              "type": "integer"
            },
            "peers": {
              "type": [
                "integer",
                "null"
              ]
            },
            "syncing": {
              "type": "boolean"
            },
            "finalizedHeight": {
              "type": "integer"
            },
            "finalizedBlock": {
              "$ref": "#/components/schemas/BlockId"
            }
          },
          "required": [
            "chainId",
            "network",
            "protocolVersion",
            "syncing",
            "finalizedHeight",
            "finalizedBlock"
          ]
        }
      }
    },
    {
      "name": "getChainHead",
      "summary": "The finalized head block. Only finalized blocks are served.",
      "params": [],
      "result": {
        "name": "block",
        "schema": {
          "$ref": "#/components/schemas/Block"
        }
      }
    },
    {
      "name": "getFinalizedHead",
      "summary": "The finalized head block (same as getChainHead).",
      "params": [],
      "result": {
        "name": "block",
        "schema": {
          "$ref": "#/components/schemas/Block"
        }
      }
    },
    {
      "name": "getChainParams",
      "summary": "Chain id, protocol version and fee assets.",
      "params": [],
      "result": {
        "name": "params",
        "schema": {
          "type": "object",
          "properties": {
            "chainId": {
              "type": "integer"
            },
            "protocolVersion": {
              "type": "integer"
            },
            "feeAssets": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Asset"
              }
            }
          }
        }
      }
    },
    {
      "name": "getBlock",
      "summary": "A finalized block by id.",
      "params": [
        {
          "name": "block",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/BlockId"
          }
        }
      ],
      "result": {
        "name": "block",
        "schema": {
          "$ref": "#/components/schemas/Block"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotFound"
        }
      ]
    },
    {
      "name": "getBlockByHeight",
      "summary": "A finalized block by height.",
      "params": [
        {
          "name": "height",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        }
      ],
      "result": {
        "name": "block",
        "schema": {
          "$ref": "#/components/schemas/Block"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotFound"
        }
      ]
    },
    {
      "name": "getFinalityProof",
      "summary": "The stored finality proof of a finalized block, in canonical ACE.",
      "params": [
        {
          "name": "block",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/BlockId"
          }
        }
      ],
      "result": {
        "name": "proof",
        "schema": {
          "type": "object",
          "properties": {
            "block": {
              "$ref": "#/components/schemas/BlockId"
            },
            "height": {
              "type": "integer"
            },
            "proof": {
              "$ref": "#/components/schemas/Base16"
            }
          }
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotFound"
        }
      ]
    },
    {
      "name": "submitTransaction",
      "summary": "Admits a signed transaction (canonical ACE) to the mempool.",
      "params": [
        {
          "name": "tx",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Base16"
          }
        }
      ],
      "result": {
        "name": "accepted",
        "schema": {
          "type": "object",
          "properties": {
            "txId": {
              "$ref": "#/components/schemas/TxId"
            },
            "status": {
              "const": "ACCEPTED"
            }
          }
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/Rejected"
        }
      ]
    },
    {
      "name": "simulateTransaction",
      "summary": "Executes a transaction against the finalized state without committing it. An authorization with keys but no signatures is simulated as an unsigned preview.",
      "params": [
        {
          "name": "tx",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Base16"
          }
        }
      ],
      "result": {
        "name": "simulation",
        "schema": {
          "type": "object",
          "properties": {
            "euUsed": {
              "type": "integer"
            },
            "fee": {
              "$ref": "#/components/schemas/Amount"
            },
            "receipt": {
              "$ref": "#/components/schemas/Receipt"
            }
          }
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/SimulationFailed"
        }
      ]
    },
    {
      "name": "getTransaction",
      "summary": "A finalized transaction with its receipt.",
      "params": [
        {
          "name": "txId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/TxId"
          }
        }
      ],
      "result": {
        "name": "transaction",
        "schema": {
          "type": "object"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotFound"
        }
      ]
    },
    {
      "name": "getReceipt",
      "summary": "The receipt of a finalized transaction, with its events.",
      "params": [
        {
          "name": "txId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/TxId"
          }
        }
      ],
      "result": {
        "name": "receipt",
        "schema": {
          "$ref": "#/components/schemas/Receipt"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotFound"
        }
      ]
    },
    {
      "name": "getAccount",
      "summary": "An account record at the finalized tip.",
      "params": [
        {
          "name": "address",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Address"
          }
        }
      ],
      "result": {
        "name": "account",
        "schema": {
          "type": "object"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotFound"
        }
      ]
    },
    {
      "name": "getBalance",
      "summary": "One asset balance of an address at the finalized tip.",
      "params": [
        {
          "name": "address",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Address"
          }
        },
        {
          "name": "asset",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Asset"
          }
        }
      ],
      "result": {
        "name": "balance",
        "schema": {
          "type": "object",
          "properties": {
            "asset": {
              "$ref": "#/components/schemas/Asset"
            },
            "available": {
              "$ref": "#/components/schemas/Units"
            },
            "locked": {
              "$ref": "#/components/schemas/Units"
            },
            "display": {
              "type": [
                "string",
                "null"
              ]
            },
            "height": {
              "type": "integer"
            }
          }
        }
      }
    },
    {
      "name": "getAssets",
      "summary": "The assets the chain knows and their configuration.",
      "params": [],
      "result": {
        "name": "assets",
        "schema": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "getMonetarySupply",
      "summary": "The supply ledger of an asset: issued, circulating, locked and burned, in base units.",
      "params": [
        {
          "name": "asset",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Asset"
          }
        }
      ],
      "result": {
        "name": "supply",
        "schema": {
          "type": "object",
          "properties": {
            "asset": {
              "$ref": "#/components/schemas/Asset"
            },
            "height": {
              "type": "integer"
            },
            "issuedTotal": {
              "$ref": "#/components/schemas/Units"
            },
            "circulating": {
              "$ref": "#/components/schemas/Units"
            },
            "locked": {
              "$ref": "#/components/schemas/Units"
            },
            "burnedTotal": {
              "$ref": "#/components/schemas/Units"
            }
          }
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotFound"
        }
      ]
    },
    {
      "name": "getValidatorSet",
      "summary": "The validator set of an epoch (default: the current one).",
      "params": [
        {
          "name": "epoch",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        }
      ],
      "result": {
        "name": "validatorSet",
        "schema": {
          "type": "object"
        }
      }
    },
    {
      "name": "getAccountHistory",
      "summary": "Finalized transactions touching an address, newest first.",
      "params": [
        {
          "name": "address",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Address"
          }
        },
        {
          "name": "limit",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 25
          }
        },
        {
          "name": "before",
          "required": false,
          "schema": {
            "type": "string",
            "pattern": "^[0-9]+:[0-9]+$"
          },
          "description": "The `next` cursor of a previous page."
        }
      ],
      "result": {
        "name": "history",
        "schema": {
          "type": "object",
          "properties": {
            "transactions": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "next": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    {
      "name": "getStateProof",
      "summary": "A record at the finalized tip with its Merkle proof against the tip's state root. Without `record`: an account (address), balance (address + asset) or supply ledger (asset). With `record`: contract (address), identity, credential, residence, parcel, proposal or bridgeTransfer (id), bridgeRoute (route), bridgeEscrow. The node verifies the proof before serving it; verify it yourself against a header you trust.",
      "params": [
        {
          "name": "address",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/Address"
          }
        },
        {
          "name": "asset",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/Asset"
          }
        },
        {
          "name": "record",
          "required": false,
          "schema": {
            "type": "string",
            "enum": [
              "account",
              "balance",
              "supply",
              "contract",
              "identity",
              "credential",
              "residence",
              "parcel",
              "proposal",
              "bridgeRoute",
              "bridgeTransfer",
              "bridgeEscrow"
            ]
          }
        },
        {
          "name": "id",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/Word"
          }
        },
        {
          "name": "route",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        }
      ],
      "result": {
        "name": "stateProof",
        "schema": {
          "type": "object",
          "properties": {
            "record": {
              "type": "string",
              "enum": [
                "account",
                "balance",
                "supply",
                "contract",
                "identity",
                "credential",
                "residence",
                "parcel",
                "proposal",
                "bridgeRoute",
                "bridgeTransfer",
                "bridgeEscrow"
              ]
            },
            "height": {
              "type": "integer"
            },
            "block": {
              "$ref": "#/components/schemas/BlockId"
            },
            "stateRoot": {
              "$ref": "#/components/schemas/Hash"
            },
            "key": {
              "$ref": "#/components/schemas/Hash"
            },
            "value": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Base16"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proof": {
              "$ref": "#/components/schemas/Base16"
            }
          },
          "required": [
            "record",
            "height",
            "block",
            "stateRoot",
            "key",
            "value",
            "proof"
          ]
        }
      }
    },
    {
      "name": "getEvents",
      "summary": "Finalized events by emitter, event type or topic, newest first. Every filter given must match; at least one is required. A transfer's topics are its sender and recipient (as 32-byte words) and its asset.",
      "params": [
        {
          "name": "emitter",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/Address"
          }
        },
        {
          "name": "eventType",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/Word"
          }
        },
        {
          "name": "topic",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/Word"
          }
        },
        {
          "name": "limit",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          }
        },
        {
          "name": "before",
          "required": false,
          "schema": {
            "type": "string",
            "pattern": "^[0-9]+:[0-9]+:[0-9]+$"
          },
          "description": "The `next` cursor of a previous page."
        }
      ],
      "result": {
        "name": "events",
        "schema": {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "txId": {
                    "$ref": "#/components/schemas/TxId"
                  },
                  "height": {
                    "type": "integer"
                  },
                  "index": {
                    "type": "integer"
                  },
                  "eventIndex": {
                    "type": "integer"
                  },
                  "emitter": {
                    "$ref": "#/components/schemas/Address"
                  },
                  "eventType": {
                    "$ref": "#/components/schemas/Hash"
                  },
                  "topics": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Hash"
                    }
                  },
                  "data": {
                    "$ref": "#/components/schemas/Base16"
                  }
                }
              }
            },
            "next": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "events",
            "next"
          ]
        }
      }
    },
    {
      "name": "getContract",
      "summary": "A deployed contract: code hash, deployer, Arno version and the routines a client can call (entry, view, constructor). Run a view routine with simulateTransaction as an unsigned preview.",
      "params": [
        {
          "name": "address",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Address"
          }
        }
      ],
      "result": {
        "name": "contract",
        "schema": {
          "type": "object",
          "properties": {
            "address": {
              "$ref": "#/components/schemas/Address"
            },
            "height": {
              "type": "integer"
            },
            "block": {
              "$ref": "#/components/schemas/BlockId"
            },
            "codeHash": {
              "$ref": "#/components/schemas/Hash"
            },
            "deployer": {
              "$ref": "#/components/schemas/Address"
            },
            "arnoVersion": {
              "type": "string"
            },
            "codeBytes": {
              "type": "integer"
            },
            "routines": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "entry",
                      "view",
                      "constructor"
                    ]
                  },
                  "params": {
                    "type": "integer"
                  },
                  "returns": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotFound"
        }
      ]
    }
  ],
  "components": {
    "schemas": {
      "Address": {
        "type": "string",
        "pattern": "^alt:[0-9a-fA-F]{40}$",
        "description": "20-byte address with EIP-55 casing folded with the network (ADR-062)."
      },
      "TxId": {
        "type": "string",
        "pattern": "^alt:T[0-9a-fA-F]{64}$"
      },
      "BlockId": {
        "type": "string",
        "pattern": "^alt:B[0-9a-fA-F]{64}$"
      },
      "Hash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "Base16": {
        "type": "string",
        "pattern": "^([0-9a-f]{2})*$",
        "description": "Lower-case base16 of canonical ACE bytes."
      },
      "Asset": {
        "type": "string",
        "enum": [
          "AEY",
          "ALnT"
        ]
      },
      "Units": {
        "type": "string",
        "pattern": "^[0-9]+$",
        "description": "An amount in base units, as a decimal string (AEY 18 decimals, ALnT 3)."
      },
      "Amount": {
        "type": "object",
        "properties": {
          "asset": {
            "$ref": "#/components/schemas/Asset"
          },
          "amount": {
            "$ref": "#/components/schemas/Units"
          },
          "display": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Block": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/BlockId"
          },
          "height": {
            "type": "integer"
          },
          "stateRoot": {
            "$ref": "#/components/schemas/Hash"
          },
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TxId"
            }
          }
        }
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "txId": {
            "$ref": "#/components/schemas/TxId"
          },
          "height": {
            "type": "integer"
          },
          "index": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "errorCode": {
            "type": "integer"
          },
          "errorName": {
            "type": "string"
          },
          "euUsed": {
            "type": "integer"
          },
          "fee": {
            "$ref": "#/components/schemas/Amount"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Word": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$",
        "description": "A 32-byte value: an event type (BLAKE3 of the event schema name) or a topic."
      }
    },
    "errors": {
      "NotFound": {
        "code": -32002,
        "message": "Not found"
      },
      "Rejected": {
        "code": -32010,
        "message": "Transaction rejected"
      },
      "SimulationFailed": {
        "code": -32011,
        "message": "Simulation failed"
      },
      "RateLimited": {
        "code": -32001,
        "message": "Rate limited"
      }
    }
  }
}
