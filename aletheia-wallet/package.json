{
  "name": "aletheia-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aletheia Wallet, the private ledger: the official non-custodial wallet for AletheiaChain.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/check-bundles.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "contrast": "node scripts/check-contrast.mjs",
    "generate:contours": "node scripts/generate-contours.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "hash-wasm": "4.12.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/manrope": "5.3.0",
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-vercel": "6.3.4",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.0",
    "globals": "16.4.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
