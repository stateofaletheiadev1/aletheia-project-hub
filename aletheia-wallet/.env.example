# Public configuration (read at build time; nothing here is secret).
PUBLIC_STABLECHAIN_RPC_URL=https://rpc.stateofaletheia.org/rpc/v1
PUBLIC_STABLECHAIN_REST_URL=https://rpc.stateofaletheia.org/api/v1
# Pushed blocks, transaction status and account events (node ADR-064). If it cannot be reached
# the wallet polls instead (ADR-0004); set it empty to always poll.
PUBLIC_STABLECHAIN_WS_URL=wss://rpc.stateofaletheia.org/ws/v1
PUBLIC_STABLECHAIN_CHAIN_ID=7770
# mainnet | private-validation | devnet | regtest
PUBLIC_STABLECHAIN_NETWORK=mainnet
# Block 0 of the expected chain; the wallet refuses a node whose genesis differs.
PUBLIC_STABLECHAIN_GENESIS_BLOCK=alt:B7d6ec0526856a85C12a0B95edC508D378b8dfF222e7caC6cE8C7D026278a4819
PUBLIC_EXPLORER_URL=https://aletheiascan.mainnet.stateofaletheia.org
PUBLIC_SITE_URL=https://wallet.mainnet.stateofaletheia.org
# Signing on mainnet stays off until the coin type and mnemonic rule are confirmed (PROTOCOL D-1, D-2).
# Set to "enabled" only on the protocol owner's decision.
PUBLIC_MAINNET_SIGNING=disabled
