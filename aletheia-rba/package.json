{
	"name": "aletheia-rba",
	"description": "Public website of the Reserve Bank of Aletheia (rba.aletheiagov.org)",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.1.3",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && tsx scripts/search-index.ts",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test:styleguide": "playwright test -c playwright.styleguide.config.ts",
		"lint:claims": "tsx scripts/claims-lint.ts",
		"lint:links": "tsx scripts/check-links.ts",
		"verify": "pnpm check && pnpm lint && pnpm test:unit && pnpm build && pnpm lint:claims && pnpm lint:links && pnpm test:e2e && pnpm test:styleguide"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "1.0.0",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"linkinator": "^8.1.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "^0.35.5",
		"svelte": "5.57.2",
		"svelte-check": "^4.7.7",
		"tslib": "^2.8.1",
		"tsx": "^4.23.15",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"zod": "^4.6.7"
	}
}
