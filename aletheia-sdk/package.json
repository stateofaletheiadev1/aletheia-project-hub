{
  "name": "@aletheia/aletheiachain",
  "version": "0.1.0",
  "description": "TypeScript client for AletheiaChain: identifiers, ACE encoding, transactions, signing, JSON-RPC and WebSocket, and state-proof verification.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip39": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
