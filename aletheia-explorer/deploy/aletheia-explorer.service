# systemd unit for the Aletheia explorer (SvelteKit, adapter-node). It reads a full node's RPC
# on loopback and serves on 127.0.0.1:3000 behind nginx. Install to /etc/systemd/system/.
[Unit]
Description=AletheiaChain explorer
After=network-online.target aletheiad.service
Wants=network-online.target

[Service]
Type=simple
User=aletheia-explorer
Group=aletheia-explorer
WorkingDirectory=/opt/aletheia-explorer
ExecStart=/usr/local/bin/node /opt/aletheia-explorer/build
Environment=NODE_ENV=production
Environment=ALETHEIA_RPC=http://127.0.0.1:7781
Environment=HOST=127.0.0.1
Environment=PORT=3000
# Behind nginx: take the origin from the proxy's headers.
Environment=PROTOCOL_HEADER=x-forwarded-proto
Environment=HOST_HEADER=x-forwarded-host
Environment=ADDRESS_HEADER=x-forwarded-for
Environment=XFF_DEPTH=1
Restart=always
RestartSec=3
MemoryHigh=200M
MemoryMax=300M

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
