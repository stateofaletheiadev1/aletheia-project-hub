{
  "$comment": "Single source of colour and shape tokens for the Aletheia Explorer (spec 41A.4, 41A.18). Generate CSS with `npm run tokens`; never type a hex value into a component.",
  "color": {
    "light": {
      "paper": { "value": "#F6F3EC", "role": "page" },
      "vellum": { "value": "#EDE8DD", "role": "raised surfaces, table stripes" },
      "rule": { "value": "#D8D1C2", "role": "hairlines" },
      "rule-strong": { "value": "#BDB4A2", "role": "section rules, table heads" },
      "ink": { "value": "#16181C", "role": "primary text" },
      "ink-soft": { "value": "#4A4E55", "role": "secondary text" },
      "ink-faint": { "value": "#65686F", "role": "captions, labels; spec #6E7178 measured 4.41:1 on paper and 4.00:1 on vellum (ERRATA E-13)" },
      "ledger-green": { "value": "#0F5C4A", "role": "links, AEY, incoming value" },
      "brass": { "value": "#A9824B", "role": "finality: seal, finalized marks, focus rings. Nothing else." },
      "brass-deep": { "value": "#7E5F33", "role": "brass text on paper" },
      "oxblood": { "value": "#9B2F28", "role": "failures, rejected, traps, corrections" },
      "slate-blue": { "value": "#34506B", "role": "ALnT, informational" }
    },
    "dark": {
      "paper": { "value": "#111315" },
      "vellum": { "value": "#181B1E" },
      "rule": { "value": "#2A2E33" },
      "rule-strong": { "value": "#3A3F45" },
      "ink": { "value": "#ECE7DC" },
      "ink-soft": { "value": "#B3AEA4" },
      "ink-faint": { "value": "#8C877E" },
      "ledger-green": { "value": "#5FAF94" },
      "brass": { "value": "#C9A46A" },
      "brass-deep": { "value": "#D6B47E" },
      "oxblood": { "value": "#D0685E" },
      "slate-blue": { "value": "#8FA9C4" }
    },
    "high-contrast": {
      "rule": { "value": "#8C8576" },
      "ink-faint": { "value": "#4A4E55" }
    }
  },
  "shape": {
    "radius": "2px",
    "hairline": "1px solid var(--rule)"
  },
  "grain": {
    "light": "0.035",
    "dark": "0.05",
    "high-contrast": "0"
  },
  "contrast": {
    "$comment": "Text/background pairs checked against WCAG 2.2 AA by scripts/check-contrast.mjs. large = 3:1 (24px+, or 18.66px+ bold), body = 4.5:1.",
    "pairs": [
      { "text": "ink", "background": "paper", "size": "body" },
      { "text": "ink", "background": "vellum", "size": "body" },
      { "text": "ink-soft", "background": "paper", "size": "body" },
      { "text": "ink-soft", "background": "vellum", "size": "body" },
      { "text": "ink-faint", "background": "paper", "size": "body" },
      { "text": "ink-faint", "background": "vellum", "size": "body" },
      { "text": "ledger-green", "background": "paper", "size": "body" },
      { "text": "ledger-green", "background": "vellum", "size": "body" },
      { "text": "brass-deep", "background": "paper", "size": "body" },
      { "text": "brass", "background": "paper", "size": "large" },
      { "text": "oxblood", "background": "paper", "size": "body" },
      { "text": "slate-blue", "background": "paper", "size": "body" }
    ]
  }
}
