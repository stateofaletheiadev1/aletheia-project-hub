# Placeholders only. Never commit real values.
APP_ENV=local
APP_BASE_URL=http://localhost:3200
# Optional. When set, /.well-known/security.txt is served with this contact.
SECURITY_CONTACT=
# Not used yet: AletheiaDB integration is pending (docs/database-integration.md).
ALETHEIADB_URL=
ALETHEIADB_API_KEY=
ALETHEIADB_DATABASE=

# Outgoing email through Zoho Mail. Without SMTP_USER and SMTP_PASS no email is sent.
# Check the login and find the right host with: node --env-file=<file> aletheia-web/scripts/mail/test.mjs <recipient>
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=no-reply@stateofaletheia.org
SMTP_PASS=
MAIL_FROM="The Government of Aletheia <no-reply@stateofaletheia.org>"
MAIL_NOTIFY=info@stateofaletheia.org
